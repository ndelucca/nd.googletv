<?xml version="1.0" encoding="utf-8" ?>

<Included>
    <Decoders>
        <MediaCodec name="OMX.realtek.video.decoder">
            <!-- AVC Video Decoder -->
            <Type name="video/avc">
                <Limit name="size" min="32x32" max="4096x2176" />
                <Limit name="concurrent-instances" max="2" />
                <Feature name="adaptive-playback" />
                <Feature name="tunneled-playback" />
            </Type>
            <!-- HEVC Video Decoder -->
            <Type name="video/hevc">
                <Limit name="size" min="2x2" max="4096x2176" />
                <Limit name="bitrate" range="1-80000000" />
                <Limit name="concurrent-instances" max="2" />
                <Feature name="adaptive-playback" />
                <Feature name="tunneled-playback" />
            </Type>
            <!-- MPEG2 Video Decoder -->
            <Type name="video/mpeg2">
                <Limit name="size" min="2x2" max="1920x1088" />
                <Limit name="concurrent-instances" max="2" />
            </Type>
            <!-- MPEG4 Video Decoder -->
            <Type name="video/mp4v-es">
                <Limit name="size" min="2x2" max="1920x1088" />
                <Limit name="concurrent-instances" max="2" />
            </Type>
            <!-- VP9 Video Decoder -->
            <Type name="video/x-vnd.on2.vp9">
                <Limit name="size" min="2x2" max="4096x2176" />
                <Limit name="bitrate" range="1-80000000" />
                <Limit name="concurrent-instances" max="2" />
                <Feature name="adaptive-playback" />
                <Feature name="tunneled-playback" />
            </Type>
            <!-- VP8 Video Decoder -->
            <!--
            <Type name="video/x-vnd.on2.vp8">
                <Limit name="size" min="2x2" max="1920x1088" />
                <Limit name="concurrent-instances" max="2" />
                <Feature name="adaptive-playback" />
                <Feature name="tunneled-playback" />
            </Type>
            -->
            <!-- AV1 Video Decoder -->
            <Type name="video/av01">
                <Limit name="size" min="2x2" max="4096x2176" />
                <Limit name="bitrate" range="1-80000000" />
                <Limit name="concurrent-instances" max="2" />
                <Feature name="adaptive-playback" />
                <Feature name="tunneled-playback" />
                <Feature name="low-latency" />
            </Type>
            <!-- 3GPP Video Decoder -->
            <Type name="video/3gpp">
                <Limit name="size" min="2x2" max="1920x1088" />
                <Limit name="concurrent-instances" max="2" />
            </Type>
        </MediaCodec>

        <MediaCodec name="OMX.realtek.video.decoder.secure">
            <!-- MPEG4 Video Decoder -->
            <Type name="video/mp4v-es">
                <Limit name="size" min="2x2" max="1920x1088" />
                <Limit name="concurrent-instances" max="1" />
                <Feature name="adaptive-playback" />
                <Feature name="tunneled-playback" />
                <Feature name="secure-playback" required="true"/>
            </Type>

            <!-- AVC Video Decoder -->
            <Type name="video/avc">
                <Limit name="size" min="32x32" max="4096x2176" />
                <Limit name="concurrent-instances" max="1" />
                <Feature name="adaptive-playback" />
                <Feature name="tunneled-playback" />
                <Feature name="secure-playback" required="true" />
            </Type>

            <!-- HEVC Video Decoder -->
            <Type name="video/hevc">
                <Limit name="size" min="2x2" max="4096x2176" />
                <Limit name="concurrent-instances" max="1" />
                <Limit name="bitrate" range="1-80000000" />
                <Feature name="adaptive-playback" />
                <Feature name="tunneled-playback" />
                <Feature name="secure-playback" required="true"/>
            </Type>

            <!-- VP9 Video Decoder -->
            <Type name="video/x-vnd.on2.vp9">
                <Limit name="size" min="2x2" max="4096x2176" />
                <Limit name="concurrent-instances" max="1" />
                <Limit name="bitrate" range="1-80000000" />
                <Feature name="adaptive-playback" />
                <Feature name="tunneled-playback" />
                <Feature name="secure-playback" required="true" />
            </Type>

            <!-- AV1 Video Decoder -->
            <Type name="video/av01">
                <Limit name="size" min="2x2" max="4096x2176" />
                <Limit name="concurrent-instances" max="1" />
                <Limit name="bitrate" range="1-80000000" />
                <Feature name="adaptive-playback" />
                <Feature name="tunneled-playback" />
                <Feature name="low-latency" />
                <Feature name="secure-playback" required="true" />
            </Type>
        </MediaCodec>
    </Decoders>

    <Encoders>
        <MediaCodec name="OMX.RTK.video.encoder" type="video/avc" >
            <Limit name="size" min="176x144" max="1920x1088" />
            <Limit name="alignment" value="16x16" />
            <Limit name="block-size" value="16x16" />
            <Limit name="blocks-per-second" range="1-244800" />
            <Limit name="bitrate" range="1-12000000" />
            <Limit name="concurrent-instances" max="1" />
            <Quirk name="requires-allocate-on-input-ports" />
            <Quirk name="requires-allocate-on-output-ports" />
        </MediaCodec>
    </Encoders>

</Included>
